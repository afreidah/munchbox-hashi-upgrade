#!/bin/sh
# -------------------------------------------------------------------------------
# cinc-client - Converge This Node Onto The Pinned Version
#
# Author: Alex Freidah
#
# Stands in for Chef. It does what the real converge does from the tool's point
# of view: read the version pinned in the `versions` data bag, install it if the
# running binary differs, restart the agent, and exit zero or non-zero.
#
# What it does not do is run a cookbook. The orchestration around a converge is
# this repository's concern; whether a cookbook installs Nomad correctly is the
# cookbook's, and it lives elsewhere.
#
# The run lock is held at the path the tool checks, so a Freeze that arrives
# mid-converge sees what it would see on a real node.
# -------------------------------------------------------------------------------

set -eu

readonly server="${CINC_SERVER:-http://cinc-server:8889/organizations/test}"
readonly lock=/var/cinc/cache/cinc-client-running.pid
readonly pidfile=/var/run/agent.pid

# Which tool this node runs, written when the image was built. Read from a file
# because this runs over ssh, whose session environment carries nothing the
# image set.
readonly tool="$(cat /etc/hashi-tool 2>/dev/null || echo nomad)"

log() { printf '[cinc-client] %s\n' "$*"; }

mkdir -p "$(dirname "$lock")"
echo $$ > "$lock"
trap 'rm -f "$lock"' EXIT INT TERM

# --- The pin ---------------------------------------------------------------
#
# The server runs with signature verification off in this fleet, so a plain
# read is enough. What the tool sends is signed either way; that signing is
# covered against a server that verifies it, in the unit tests.

log "reading the pin from $server"
pinned=$(curl -fsS "$server/data/versions/$tool" | jq -r '.version // empty') || {
  log "could not read the pin"
  exit 1
}

if [ -z "$pinned" ]; then
  log "no version is pinned for $tool"
  exit 1
fi

# Both tools print "<Name> v<version>" on the first line, with the name
# capitalised; everything after the v is the version.
running=$("$tool" version | head -1 | sed -E 's/^[A-Za-z]+ v//')
log "pinned $pinned, running $running"

if [ "$pinned" = "$running" ]; then
  log "already converged"
  exit 0
fi

# --- Install ---------------------------------------------------------------

readonly url="https://releases.hashicorp.com/${tool}/${pinned}/${tool}_${pinned}_linux_amd64.zip"

# Announced with its size and timed, because these releases run to a couple of
# hundred megabytes and curl is silent while it works. A minute of nothing
# after "fetching" reads as a hang, and on the first run against a fleet that
# is exactly what it looks like.
size=$(curl -fsSI -m 30 "$url" 2>/dev/null | tr -d '\r' | awk 'tolower($1)=="content-length:"{print int($2/1048576)}')
log "fetching $url (${size:-?} MB)"

tmp=$(mktemp -d)
started=$(date +%s)

curl -fsS -o "$tmp/release.zip" "$url" || { log "download failed"; exit 1; }
log "downloaded in $(( $(date +%s) - started ))s"

unzip -o -q "$tmp/release.zip" -d "$tmp" || { log "unzip failed"; exit 1; }

install -m 0755 "$tmp/$tool" "/bin/$tool"
rm -rf "$tmp"
log "installed $("$tool" version | head -1)"

# --- Restart ---------------------------------------------------------------
#
# The supervisor brings the agent back on the new binary. Signalling it is what
# makes a run's gates wait for something real: the host leaves the cluster and
# has to rejoin.

if [ -f "$pidfile" ]; then
  log "restarting the agent"
  kill "$(cat "$pidfile")" 2>/dev/null || true
else
  log "no agent pid file; nothing to restart"
  exit 1
fi

log "converge complete"
